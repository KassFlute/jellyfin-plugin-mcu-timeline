<Project Sdk="Microsoft.NET.Sdk">

  <!-- one build per Jellyfin minor: dotnet build -p:JellyfinAbi=10.10. Each is compiled
       against the first release of that minor, so it runs on every patch release after it -->
  <PropertyGroup>
    <JellyfinAbi Condition="'$(JellyfinAbi)' == ''">10.11</JellyfinAbi>
    <JellyfinPackage>$(JellyfinAbi).0</JellyfinPackage>
    <TargetFramework Condition="'$(JellyfinAbi)' == '10.11'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(JellyfinAbi)' != '10.11'">net8.0</TargetFramework>
    <DefineConstants>$(DefineConstants);JELLYFIN_$(JellyfinAbi.Replace('.', '_'))</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.McuTimeline</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.McuTimeline</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../../jellyfin.ruleset</CodeAnalysisRuleSet>
    <!-- new in the .NET 10 SDK, flags the boxing of every value type log argument. No log
         call here sits on a hot path -->
    <NoWarn>$(NoWarn);CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackage)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinPackage)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Data\mcu-timeline.json" />
    <EmbeddedResource Include="Data\collection-*.jpg" />
    <EmbeddedResource Include="Web\*" />
  </ItemGroup>

</Project>
