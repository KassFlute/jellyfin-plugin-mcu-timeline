<Project Sdk="Microsoft.NET.Sdk">

  <!-- one build per Jellyfin version: dotnet build -p:JellyfinAbi=10.10. Each is compiled
       against the first release of that version, so it runs on every release after it. 12
       covers all of 12.x, whose minor releases keep the plugin interface -->
  <PropertyGroup>
    <JellyfinAbi Condition="'$(JellyfinAbi)' == ''">10.11</JellyfinAbi>
    <JellyfinPackage>$(JellyfinAbi).0</JellyfinPackage>
    <JellyfinPackage Condition="'$(JellyfinAbi)' == '12'">12.0.0</JellyfinPackage>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition="'$(JellyfinAbi)' == '10.11'">net9.0</TargetFramework>
    <TargetFramework Condition="'$(JellyfinAbi)' == '12'">net10.0</TargetFramework>
    <!-- 10.11 moved the user entities, 12 kept the 10.11 layout -->
    <DefineConstants Condition="'$(JellyfinAbi)' == '10.11' Or '$(JellyfinAbi)' == '12'">$(DefineConstants);JELLYFIN_10_11_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.McuTimeline</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.McuTimeline</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../../jellyfin.ruleset</CodeAnalysisRuleSet>
    <!-- new in the .NET 10 SDK, flags the boxing of every value type log argument. No log
         call here sits on a hot path -->
    <NoWarn>$(NoWarn);CA1873</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackage)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinPackage)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Data\mcu-timeline.json" />
    <EmbeddedResource Include="Data\collection-*.jpg" />
    <EmbeddedResource Include="Web\*" />
  </ItemGroup>

</Project>
